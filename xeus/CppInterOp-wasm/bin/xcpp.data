/// 		ELSE
/// 			dst.fp16[i] := convert_fp32_to_fp16(__A.fp32[i - 4])
/// 		FI
/// 	ELSE
/// 		dst.fp16[i] := 0
/// 	FI
/// ENDFOR
///
/// dst[MAX:128] := 0
/// \endcode
///
/// \headerfile <immintrin.h>
///
/// This intrinsic corresponds to the \c VCVT2PS2PHX instruction.
///
/// \param __U
///    A 8-bit zeroing mask.
/// \param __A
