#    endif // _LIBCPP_STD_VER >= 20

#    if _LIBCPP_STD_VER >= 26
  template <class _Tp>
    requires is_convertible_v<const _Tp&, basic_string_view<_CharT, _Traits>>
  _LIBCPP_HIDE_FROM_ABI void str(const _Tp& __t) {
