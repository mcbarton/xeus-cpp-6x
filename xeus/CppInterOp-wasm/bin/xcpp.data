#endif
}

/* -(a[0] * b[0]) + c[0], a[1] pass through */
static __inline__ __m128d __attribute__((__always_inline__, __nodebug__))
_mm_fnmadd_sd(__m128d __A, __m128d __B, __m128d __C) {
