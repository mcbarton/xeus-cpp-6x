// standard-mandated includes

#  if _LIBCPP_STD_VER >= 17
#    include <__memory/construct_at.h>
#    include <__memory/destroy.h>
#  endif

#  if _LIBCPP_STD_VER >= 20
#    include <__memory/assume_aligned.h>
#    include <__memory/concepts.h>
