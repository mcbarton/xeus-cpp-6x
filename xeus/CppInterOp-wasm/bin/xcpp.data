template <class _Tp, class _Alloc>
_LIBCPP_CONSTEXPR_SINCE_CXX26 forward_list<_Tp, _Alloc>::forward_list(const forward_list& __x)
    : __base(__node_traits::select_on_container_copy_construction(__x.__alloc_)) {
