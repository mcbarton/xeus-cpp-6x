  static_assert(_And<is_constructible<__decay_t<_Args>, _Args>...>::value, "");
  static_assert(__is_invocable_v<__decay_t<_Fp>, __decay_t<_Args>...>, "");

  typedef __async_func<__decay_t<_Fp>, __decay_t<_Args>...> _BF;
