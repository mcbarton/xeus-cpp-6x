                     (__m128d)wasm_f64x2_relaxed_nmadd(
                       (__f64x2)__A, (__f64x2)__B, (__f64x2)neg_c));
#else
  __m128d neg_ab = _mm_sub_sd(_mm_setzero_pd(), _mm_mul_sd(__A, __B));
  return _mm_move_sd(__A, _mm_sub_sd(neg_ab, __C));
