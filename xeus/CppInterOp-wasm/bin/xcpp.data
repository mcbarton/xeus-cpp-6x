    union {                                                                    \
      long long d;                                                             \
      int w[2];                                                                \
    } _HEXAGON_V64_internal_union;                                                   \
    _HEXAGON_V64_internal_union.d = (v);                                             \
    _HEXAGON_V64_internal_union.w[0];                                                \
  })
