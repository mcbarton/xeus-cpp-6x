/// 	ELSE
/// 		dst.hf8[i] := __W.hf8[i]
/// 	FI
/// ENDFOR
///
/// dst[MAX:128] := 0
/// \endcode
///
/// \headerfile <immintrin.h>
///
/// This intrinsic corresponds to the \c VCVTPH2HF8S instruction.
///
/// \param __W
///    A 128-bit vector of [16 x hf8].
/// \param __U
///    A 16-bit merging mask.
/// \param __A
///    A 256-bit vector of [8 x fp16].
/// \returns
