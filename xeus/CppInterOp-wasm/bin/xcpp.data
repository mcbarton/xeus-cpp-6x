                                                   (__v64qi)(__m512i)(B), \
                                                   (char)(I)))

#define _mm512_mask_gf2p8affine_epi64_epi8(S, U, A, B, I) \
  ((__m512i)__builtin_ia32_selectb_512((__mmask64)(U), \
         (__v64qi)_mm512_gf2p8affine_epi64_epi8((A), (B), (I)), \
         (__v64qi)(__m512i)(S)))

#define _mm512_maskz_gf2p8affine_epi64_epi8(U, A, B, I) \
