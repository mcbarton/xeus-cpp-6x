#ifndef _LIBCPP___CHRONO_HIGH_RESOLUTION_CLOCK_H
#define _LIBCPP___CHRONO_HIGH_RESOLUTION_CLOCK_H

#include <__chrono/steady_clock.h>
#include <__chrono/system_clock.h>
#include <__config>

