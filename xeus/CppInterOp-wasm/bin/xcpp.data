      typedef ostreambuf_iterator<_CharT, _Traits> _Ip;
      if (std::__pad_and_output(
              _Ip(__os),
              std::addressof(__c),
              std::addressof(__c) + (((__os.flags() & ios_base::adjustfield) == ios_base::left) ? 1 : 0),
              std::addressof(__c) + 1,
              __os,
              __os.fill())
              .failed())
